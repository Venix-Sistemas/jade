{
  "name": "@venix-sistemas/nuxt-theme",
  "version": "1.0.0-alpha.1",
  "description": "Complete color system for Nuxt: seasonal colors, automatic theme, SSR, Cookie Policy, cursor, scrollbar, etc...",
  "keywords": [
    "nuxt",
    "module",
    "theme",
    "colors",
    "dark-mode",
    "typography",
    "scrollbar",
    "cursor"
  ],
  "license": "MIT",
  "type": "module",
  "author": "Vinicius da Silva Viana <contato@venixsistemas.com>",
  "repository": "Venix-Sistemas/nuxt-theme",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs",
      "exports": "./src/module.ts"
    },
    "./theme.json": "./dist/shared/theme.json",
    "./unocss": {
      "types": "./dist/shared/unocss-preset.d.ts",
      "import": "./dist/shared/unocss-preset.js"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@iconify-json/line-md": "^1.2.16",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/utils": "^3.1.4",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/kit": "^4.5.2"
  },
  "devDependencies": {
    "@nuxt/devtools": "4.0.0-alpha.18",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.3.2",
    "@nuxtjs/i18n": "10.6.0",
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "eslint": "^10.10.0",
    "nuxt": "^4.5.2",
    "typescript": "^6.0.3",
    "vitest": "5.0.0",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@12.3.4"
}