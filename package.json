{
  "name": "@venix-sistemas/jade",
  "version": "1.2.0",
  "description": "UI foundation for Nuxt in a single module: color themes (seasonal, SSR, cookie consent), typography, scrollbar, cursor, icons, i18n, plus UnoCSS and Vuetify integrations.",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "ui",
    "design-system",
    "nuxt-theme",
    "jade",
    "jade-theme",
    "theme",
    "theming",
    "colors",
    "dark-mode",
    "seasonal-theme",
    "typography",
    "scrollbar",
    "cursor",
    "unocss",
    "vuetify",
    "iconify",
    "i18n"
  ],
  "license": "MIT",
  "type": "module",
  "author": "Vinicius da Silva Viana <contato@venixsistemas.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Venix-Sistemas/jade.git"
  },
  "homepage": "https://github.com/Venix-Sistemas/jade#readme",
  "bugs": {
    "url": "https://github.com/Venix-Sistemas/jade/issues"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs",
      "exports": "./src/module.ts"
    },
    "./theme.json": "./dist/shared/theme.json",
    "./unocss": {
      "types": "./dist/shared/unocss-preset.d.ts",
      "import": "./dist/shared/unocss-preset.js"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "pnpm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "release:auth": "pnpm whoami || pnpm login",
    "release": "pnpm run release:auth && pnpm run lint && pnpm run test && pnpm run prepack && changelogen --release && pnpm publish && git push --follow-tags",
    "release:alpha": "pnpm run release:auth && pnpm run lint && pnpm run test && pnpm run prepack && changelogen --release --prerelease alpha && pnpm publish --tag alpha && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@iconify-json/line-md": "^1.2.16",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/utils": "^3.1.7",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/kit": "^4.6.1"
  },
  "devDependencies": {
    "@nuxt/devtools": "4.0.0-beta.5",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.1",
    "@nuxt/test-utils": "^4.3.3",
    "@nuxtjs/i18n": "10.6.0",
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "eslint": "^10.12.0",
    "nuxt": "^4.6.1",
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@12.3.4"
}