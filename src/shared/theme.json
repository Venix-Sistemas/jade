{
    "name": "default",
    "typography": {
        "enabled": true,
        "defaultFonts": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        "fontSize": "16px",
        "customFonts": [
            {
                "name": "Iceberg",
                "preload": true,
                "sources": {
                    "woff2": "/fonts/Iceberg/Iceberg-Regular.woff2"
                },
                "weight": "normal",
                "style": "normal"
            }
        ]
    },
    "customScrollbar": {
        "enabled": true,
        "width": "auto",
        "borderRadius": "8px",
        "borderWidth": "3px",
        "colors": {
            "thumb": "primary",
            "thumbHover": "secondary",
            "track": "background2",
            "border": "background3"
        }
    },
    "customCursor": {
        "enabled": false,
        "themed": true,
        "defaultCursors": {
            "default": {
                "path": "/images/ui/cursor/cursor.png",
                "hotspot": "4 0"
            },
            "pointer": {
                "path": "/images/ui/cursor/cursor-hand.png",
                "hotspot": "8 0"
            },
            "text": {
                "path": "/images/ui/cursor/cursor-text.png",
                "hotspot": "12 12"
            }
        },
        "themeCursors": {
            "venix": "base"
        },
        "_comment": "defaultCursors: default | pointer | text --- themeCursors: <themename>: themed | base | none | { default, pointer, text }"
    },
    "colors": {
        "enabled": true,
        "defaults": true,
        "defaultColor": "dark",
        "modes": {
